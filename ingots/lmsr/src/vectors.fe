// Generated by tools/difftest.py from 60-digit Decimal references. Do not edit.
// Each case asserts cost_lower(q) <= floor(C_true) and ceil(C_true) <= cost_upper(q).
use ingot::Lmsr
use core::fixed::Wad

fn check2(b: u256, q: [u256; 2], floor: u256, ceil: u256) {
    var w: [Wad; 2] = [Wad::zero(); 2]
    var i: usize = 0
    while i < 2 {
        w[i] = Wad::from_raw(q[i])
        i += 1
    }
    let m = Lmsr<2>::new(b: Wad::from_raw(b))
    assert!(m.cost_lower(w).raw() <= floor)
    assert!(m.cost_upper(w).raw() >= ceil)
}


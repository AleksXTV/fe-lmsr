fn check4(b: u256, q: [u256; 4], floor: u256, ceil: u256) {
    var w: [Wad; 4] = [Wad::zero(); 4]
    var i: usize = 0
    while i < 4 {
        w[i] = Wad::from_raw(q[i])
        i += 1
    }
    let m = Lmsr<4>::new(b: Wad::from_raw(b))
    assert!(m.cost_lower(w).raw() <= floor)
    assert!(m.cost_upper(w).raw() >= ceil)
}


fn check8(b: u256, q: [u256; 8], floor: u256, ceil: u256) {
    var w: [Wad; 8] = [Wad::zero(); 8]
    var i: usize = 0
    while i < 8 {
        w[i] = Wad::from_raw(q[i])
        i += 1
    }
    let m = Lmsr<8>::new(b: Wad::from_raw(b))
    assert!(m.cost_lower(w).raw() <= floor)
    assert!(m.cost_upper(w).raw() >= ceil)
}

